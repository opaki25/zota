# Copy to .env before running Docker Compose. Set a unique database password.
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql+psycopg://zota:replace-with-a-long-random-password@localhost:5432/zota
REDIS_URL=redis://localhost:6379/0
APP_ORIGIN=http://localhost:3000
# Set true for HTTPS production. False is only for local HTTP development.
SECURE_COOKIES=false
API_URL=http://127.0.0.1:8000
# SMTP enables password recovery only; marketing email is not implemented.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# Reserved for subsequent phases; not consumed by Phase 1.
OPENAI_API_KEY=
GOOGLE_PLACES_API_KEY=
SEARCH_API_KEY=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_SECRET=
