{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "api": {
      "root": "apps/api",
      "framework": "fastapi",
      "entrypoint": "app.main:app"
    },
    "web": {
      "root": "apps/web",
      "framework": "nextjs",
      "installCommand": "npm ci --include=dev --include=optional",
      "bindings": [
        {
          "type": "service",
          "service": "api",
          "format": "url",
          "env": "API_SERVICE_URL"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ],
  "crons": [
    {
      "path": "/api/growth/run",
      "schedule": "0 14 * * *"
    }
  ]
}
