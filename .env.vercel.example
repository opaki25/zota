# Configure these in Vercel Project Settings for each environment.
# Use separate databases for Preview and Production. Replace placeholders.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
REDIS_URL=rediss://USER:PASSWORD@HOST:6379/0
APP_ORIGIN=https://YOUR-PROJECT.vercel.app
SECURE_COOKIES=true
API_ROOT_PATH=/api
# Optional password recovery; no outbound marketing integration is enabled.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# Do NOT add API_SERVICE_URL. It is injected by the web -> api service binding.
# Do NOT configure TESTING=true or LOCAL_API_URL on Vercel.

# Growth: keys stay server-side. Redeploy after changes.
GOOGLE_PLACES_API_KEY=
BRAVE_SEARCH_API_KEY=
# Set a random secret of at least 32 characters to authenticate the daily cron.
CRON_SECRET=
# For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587,
# SMTP_USER=opakijonathan30@gmail.com, MAIL_FROM=opakijonathan30@gmail.com
# SMTP_PASSWORD must be a Google app password, never your normal Google password.
